# Python environments, caches, and build products
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage*
htmlcov/
build/
dist/

# Local configuration and editor state
.env
.envrc
.idea/
.vscode/

# Regenerable experiment state
.vector-memory
.hf-cache/
results/.judge_cache.json
results/**/*.tmp
runlogs/run_status.txt

# Generated prompt/retrieval exports (recreated by harness.export)
prepared_prompts/
analysis/*_retrieval_logs.csv

# Historical and working documentation; keep only reviewer entry points
docs/*
!docs/README.md
!docs/final_results.md

# Canonical manuscript sources are version-controlled under paper/. Generated
# review files and upload bundles are rebuilt from those sources.
paper/*.aux
paper/*.bbl
paper/*.bcf
paper/*.blg
paper/*.fdb_latexmk
paper/*.fls
paper/*.log
paper/*.out
paper/*.run.xml
paper/*.synctex.gz
paper/*.toc
paper/*.pdf
paper/*.docx
paper/*.zip
paper/merge/
paper/overleaf_upload/
paper/notes.md
paper/neurips_2026.tex

# Local execution and delivery material
notebooks/
deliverables/
human_validation/ratings/

# Unused upstream presentation assets
submodules/Amem/Figure/
